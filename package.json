{
  "name": "galley-desk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "@electron/packager": {
      "extract-zip": "npm:@electron-internal/extract-zip@1.0.5"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm start --workspace @galley-desk/desktop",
    "package": "npm run package --workspace @galley-desk/desktop",
    "test": "vitest run",
    "test:contracts": "node scripts/check-contracts.mjs",
    "test:desktop": "playwright test",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
