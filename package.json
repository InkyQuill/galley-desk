{
  "name": "galley-desk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm start --workspace @galley-desk/desktop",
    "package": "npm run package --workspace @galley-desk/desktop",
    "test": "vitest run",
    "test:contracts": "node scripts/check-contracts.mjs",
    "test:desktop": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "make": "npm run make --workspace @galley-desk/desktop --",
    "check:release": "node scripts/release/identity.mjs --local && node --test scripts/release/*.test.mjs",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "vite": "8.3.3"
  }
}
